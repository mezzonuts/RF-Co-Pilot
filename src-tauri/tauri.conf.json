{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "identifier": "com.telecom.rf-copilot",
  "productName": "rf-copilot",
  "version": "0.1.0",
  "plugins": { "shell": { "open": true } },
  "windows": [
    { "title": "rf-copilot — TelecomAgent", "width": 1280, "height": 800, "resizable": true, "fullscreen": false }
  ]
}
