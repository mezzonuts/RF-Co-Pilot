# RF-Co-Pilot v0.4 — Environment Configuration
# Copy to .env.local and fill values (never commit .env.local)

# ── LLM Provider: 9Router (local proxy) ──
9ROUTER_BASE_URL=http://localhost:20128/v1
9ROUTER_API_KEY=[YOUR_9ROUTER_API_KEY]

# ── LLM Provider: Google Gemini (fallback) ──
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]

# ── Application ──
PORT=3000
APP_ENV=production
DEBUG=false

# ── Python Sidecar ──
PYTHONPATH=src-tauri/python
PYTHON=C:/Users/PC/AppData/Local/Python/pythoncore-3.14-64/python.exe
LOG_LEVEL=INFO

# ── Reporting ──
REPORT_OUTPUT_DIR=./reports
CHART_OUTPUT_DIR=./reports/charts
