# Production Environment Configuration (copy to .env and fill values)

# ── PostgreSQL ──
DATABASE_URL=postgresql://telecom:[REDACTED]@localhost:5432/rf_copilot
POSTGRES_USER=telecom
POSTGRES_PASSWORD=[REDACTED]
POSTGRES_DB=rf_copilot

# ── Qdrant ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=[REDACTED]

# ── Python Sidecar ──
PYTHONPATH=src-tauri/python
LOG_LEVEL=INFO

# ── Reporting ──
REPORT_OUTPUT_DIR=./reports
CHART_OUTPUT_DIR=./reports/charts

# ── QGIS Export ──
QGIS_OUTPUT_DIR=./qgis_exports
QGIS_PROJECT_TEMPLATE=qgis_template.qgs

# ── Application ──
APP_ENV=production
DEBUG=false
