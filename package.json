{
  "name": "rf-copilot",
  "version": "0.1.0",
  "description": "TelecomAgent — Tauri + React desktop app untuk RF engineering (NPM-only dev, no Rust/Docker required)",
  "type": "module",
  "bin": {
    "rf-copilot": "./bin/rf-copilot.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "index.html",
    "vite.config.*",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mezzonuts/RF-Co-Pilot.git"
  },
  "keywords": ["telecom", "rf", "tauri", "react", "vite"],
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/leaflet": "^1.9.22",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.2"
  }
}
