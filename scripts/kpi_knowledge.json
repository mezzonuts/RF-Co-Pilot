      "kpi_group": "qoe",
      "description": "Video startup/initial buffering time",
      "stats": ["avg", "median", "p95", "max"],
      "quality_thresholds": {"excellent": 500, "good": 1000, "fair": 2000, "poor": 4000}
    },
    "re_buffer": {
      "aliases": ["re_buffer", "rebuffer_time", "rebuffer_duration", "stall_duration", "rebuffer_duration"],
      "unit": "ms",
      "type": "numeric",
      "kpi_group": "qoe",
      "description": "Rebuffering duration",
      "stats": ["avg", "median", "max"],
      "quality_thresholds": {"excellent": 0, "good": 100, "fair": 500, "poor": 1000}
    },
    "resolution": {
      "aliases": ["resolution", "video_resolution", "res", "quality_level", "video_quality"],
      "unit": "",
      "type": "categorical",
      "kpi_group": "qoe",
      "description": "Video resolution",
      "stats": ["unique_count", "top_values", "value_counts"]
    },
    "error": {
      "aliases": ["error", "error_message", "fail", "failure", "error_code"],
      "unit": "",
      "type": "categorical",
      "kpi_group": "reliability",
      "description": "Error indicator",
